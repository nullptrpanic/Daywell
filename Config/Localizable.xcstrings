  "strings": {
    "%@ – %@ 次日": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – %@ next day"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – %@ 次日"
          }
        }
      }
    },
    "%@正在 Daywell 的锁定时段内。\n如需检查限制状态，请打开 Daywell。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is restricted during this Daywell block.\nOpen Daywell to check its status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@正在 Daywell 的锁定时段内。\n如需检查限制状态，请打开 Daywell。"
          }
        }
      }
    },
    "%@正在 Daywell 的锁定时段内。\n本时段已无可用豁免，等休息结束再回来。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is restricted during this Daywell block.\nYou're out of passes. Come back when the block ends."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@正在 Daywell 的锁定时段内。\n本时段已无可用豁免，等休息结束再回来。"
          }
        }
      }
    },
    "%@正在 Daywell 的锁定时段内。\n还可临时豁免 %lld 次，本次%@。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is restricted during this Daywell block.\nPasses left: %lld. This pass lasts %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@正在 Daywell 的锁定时段内。\n还可临时豁免 %lld 次，本次%@。"
          }
        }
      }
    },
