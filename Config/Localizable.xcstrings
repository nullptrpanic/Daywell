          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮豁免已用完，洗漱、喝杯水，稍后再回来。"
          }
        }
      }
    },
    "模拟器": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器"
          }
        }
      }
    },
    "模拟器可设置时段和豁免规则；应用圈选与实际锁定需在真机上使用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the simulator to try schedules and passes. App selection and restrictions require a physical device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器可设置时段和豁免规则；应用圈选与实际锁定需在真机上使用。"
          }
        }
      }
    },
    "模拟器可预览界面；应用圈选和实际锁定需要在 iPhone 或 iPad 真机上验证。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can preview the interface in the simulator. Test app selection and restrictions on an iPhone or iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器可预览界面；应用圈选和实际锁定需要在 iPhone 或 iPad 真机上验证。"
          }
        }
      }
    },
    "模拟器无法圈选或锁定真实应用。请在 iPhone 或 iPad 真机上运行 Daywell，授权屏幕使用时间后使用聚焦。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The simulator can't select or restrict real apps. To use Focus, open Daywell on an iPhone or iPad and grant Screen Time access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器无法圈选或锁定真实应用。请在 iPhone 或 iPad 真机上运行 Daywell，授权屏幕使用时间后使用聚焦。"
          }
        }
      }
    },
