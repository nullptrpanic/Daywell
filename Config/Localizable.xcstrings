    "先去洗漱、喝杯水，慢慢开始今天。\n本轮休息到 %@，之后可再使用%@。\n%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a moment to get ready for your day.\nThis break ends at %@. You can use %@ again then.\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先去洗漱、喝杯水，慢慢开始今天。\n本轮休息到 %@，之后可再使用%@。\n%@"
          }
        }
      }
    },
